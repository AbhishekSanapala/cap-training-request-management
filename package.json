{
  "name": "training-request-mgmt",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository URL here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/db-service": "^3.1.2",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "jest --runInBand"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "employee": {
            "roles": [
              "EmployeeRole"
            ],
            "attr": {
              "user": "employee"
            }
          },
          "manager": {
            "roles": [
              "ManagerRole"
            ],
            "attr": {
              "user": "manager"
            }
          },
          "admin": {
            "roles": [
              "AdminRole"
            ],
            "attr": {
              "user": "admin"
            }
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
